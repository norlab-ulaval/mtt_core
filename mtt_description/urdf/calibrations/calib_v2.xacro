<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Calibration v2 — sensor cage AFTER backward displacement.
    Generated by scripts/calib_hesai_scan.py on 2026-06-26.

    xyz = 0.850829 -0.266000 0.355000
    Δ from v1: x=+0.2308 m  y=+0.0000 m  z=+0.0000 m
    Cage backward shift: -23.1 cm

    hesai_lidar frame convention (rpy=π): X=BACKWARD, Y=RIGHT, Z=UP.
    All sensor xyz/rpy below are expressed in this frame.
  -->

  <!-- hesai_lidar origin relative to reference_point -->
  <xacro:property name="hesai_calib_xyz" value="0.850829 -0.266000 0.355000"/>
  <xacro:property name="hesai_calib_rpy" value="0 0 3.141593"/>

  <!-- IMU (Xsens MTi-100) — in hesai_lidar frame (X=BACKWARD, Y=RIGHT) -->
  <xacro:property name="imu_calib_xyz" value="0.0 0.0 0.061"/>
  <xacro:property name="imu_calib_rpy" value="-3.141593 0 -1.570797"/>
  <xacro:property name="mti10_right_calib_xyz" value="-0.030 0.295 -0.785"/>
  <xacro:property name="mti10_right_calib_rpy" value="0 1.570796 -1.570797"/>
  <xacro:property name="mti10_left_calib_xyz" value="-0.030 -0.295 -0.785"/>
  <xacro:property name="mti10_left_calib_rpy" value="0 1.570796 1.570797"/>

  <!-- ZED 2i — in hesai_lidar frame (X=BACKWARD, Y=RIGHT) -->
  <xacro:property name="zed2i_calib_xyz" value="-0.470 0.0 -0.1627"/>
  <xacro:property name="zed2i_calib_rpy" value="0 0 -3.141593"/>

  <!-- RS-Airy — in hesai_lidar frame (X=BACKWARD, Y=RIGHT) -->
  <!-- Direct ICP v2 (hesai↔rsairy, bag 2026-06-26). P2Pl 4cm voxel. RMSE=3.45cm, Δt=11.6cm. -->
  <!-- z is ill-constrained (no shared vertical structure); x/y/rpy are reliable. -->
  <xacro:property name="rsairy_calib_xyz" value="0.794671 -0.098713 -0.078812"/>
  <xacro:property name="rsairy_calib_rpy" value="3.107126 -1.244534 0.040942"/>

</robot>
