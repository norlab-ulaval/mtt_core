<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mtt_gps_teach_repeat</name>
  <version>0.1.0</version>
  <description>GPS-only teach and repeat: .traj recording, ROMEA path matching, and articulated path following.</description>

  <maintainer email="mohamed@example.com">Mohamed</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mtt_control</depend>
  <depend>mtt_interfaces</depend>
  <depend>romea_core_common</depend>
  <depend>romea_core_path</depend>
  <depend>romea_core_path_matching</depend>
  <depend>nlohmann-json-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mtt_localization</exec_depend>
  <exec_depend>mtt_bringup</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
